set(MGS_VERSION    @MGS_VERSION@)
set(MGS_SHARED_LIB @BUILD_SHARED_LIBS@)

@PACKAGE_INIT@

set_and_check(MGS_INCLUDE_DIR "@PACKAGE_MGS_INCLUDE_INSTALL_DIR@")
set_and_check(MGS_LIB_DIR     "@PACKAGE_MGS_LIB_INSTALL_DIR@")
set(MGS_BIN_DIR "@PACKAGE_MGS_BIN_INSTALL_DIR@")

find_package(ggml REQUIRED HINTS ${MGS_LIB_DIR}/cmake)

find_library(mgs_LIBRARY mgs-engine
  REQUIRED
  HINTS ${MGS_LIB_DIR}
  NO_CMAKE_FIND_ROOT_PATH
)

add_library(mgs-engine UNKNOWN IMPORTED)
set_target_properties(mgs-engine
  PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${MGS_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "ggml::ggml;ggml::ggml-base;"
    IMPORTED_LINK_INTERFACE_LANGUAGES "CXX"
    IMPORTED_LOCATION "${mgs_LIBRARY}"
    INTERFACE_COMPILE_FEATURES c_std_90
    POSITION_INDEPENDENT_CODE ON)

check_required_components(mgs)
