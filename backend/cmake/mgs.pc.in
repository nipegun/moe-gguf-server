prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: mgs-engine
Description: moe-gguf-server inference engine
Version: @MGS_VERSION@
Libs: -L${libdir} -lggml -lggml-base -lmgs-engine
Cflags: -I${includedir}
