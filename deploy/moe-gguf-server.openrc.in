#!/sbin/openrc-run

# OpenRC's interpreter and exported hook names are framework interfaces.
name="moe-gguf-server"
description="moe-gguf-server inference server"
command="@BINARY@"
# The inference API listens on a Unix socket in the web runtime directory; Apache forwards to it.
command_args="--http --host /opt/moe-gguf-server/_/temp/web/mgs.sock --api-prefix /api --api-key-file /opt/moe-gguf-server/.mgs/config/api.key --models-dir /opt/moe-gguf-server/models"
command_user="moe-gguf-server:moe-gguf-server"
command_background=true
pidfile="/run/moe-gguf-server.pid"
directory="/opt/moe-gguf-server"
output_log="/var/log/moe-gguf-server.log"
error_log="/var/log/moe-gguf-server.log"
export HOME="/opt/moe-gguf-server"

depend() {
  need net
}

start_pre() {
  checkpath --directory --owner moe-gguf-server:moe-gguf-server --mode 0750 \
    /opt/moe-gguf-server/_ /opt/moe-gguf-server/_/temp /opt/moe-gguf-server/_/temp/web
}
