[Unit]
Description=moe-gguf-server web frontend with automatic ports
After=network-online.target moe-gguf-server.service
Wants=network-online.target moe-gguf-server.service

[Service]
Type=simple
User=moe-gguf-server
Group=moe-gguf-server
WorkingDirectory=/opt/moe-gguf-server
ExecStart=/bin/bash /usr/local/libexec/moe-gguf-server/start-web.sh
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
